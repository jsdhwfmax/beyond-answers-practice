{
  "name": "beyond-answers-practice",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "eval:models": "tsx scripts/eval-models.ts",
    "check:config": "tsx scripts/check-config.ts"
  },
  "dependencies": {
    "@vercel/functions": "3.9.7",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "openai": "7.15.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "fast-check": "4.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
