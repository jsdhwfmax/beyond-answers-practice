# Copy to .env.local. Never commit real values. The development server reads this file on startup.
# API keys belong only in server-side local/cloud secrets, never NEXT_PUBLIC_*.
# Exact HTTPS origin when running behind a cloud reverse proxy (no path).
PUBLIC_APP_ORIGIN=
MODEL_PROVIDER=bailian
# Optional server-side override for free-form practice, intake and custom reply suggestions.
# Empty inherits MODEL_PROVIDER. Fixed scenarios continue to use MODEL_PROVIDER.
# Uses the selected provider's existing model/key below; errors never fall back to another provider.
CUSTOM_MODEL_PROVIDER=
DASHSCOPE_API_KEY=
# Must match the key's region. Replace with the API Host shown in your workspace if required.
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.8-max-0902
# Optional provider switch: MODEL_PROVIDER=openai. No fallback/extra billing across providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional explicit routing: CUSTOM_MODEL_PROVIDER=deepseek; MODEL_PROVIDER remains for fixed scenarios.
# Responses API uses JSON Schema and non-thinking mode; no cross-provider fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# PostgreSQL application connection. Required in production; use a restricted application role.
# For optional Neon hosting, this may be a pooled connection.
DATABASE_URL=
# PostgreSQL migration connection, used only by db:migrate. For Neon, use its direct connection.
DATABASE_URL_MIGRATION=
# Optional isolated and already migrated test database. Never point at production.
TEST_DATABASE_URL=
# Local file storage is permitted ONLY in development at .local/app-data.
# Optional maintenance endpoint secret; set for scheduled production retention cleanup.
CRON_SECRET=
# Public campus discussion feed: production uses this server-only secret plus PostgreSQL cache.
# The original development environment can also use an explicitly configured official CLI.
# This public source snapshot does not include that CLI, its skill bundle or keychain credentials.
# Never copy keychain material automatically or set a NEXT_PUBLIC_ version.
ZHIHU_ACCESS_SECRET=
